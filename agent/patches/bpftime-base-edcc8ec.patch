+                old->sa_sigaction(sig, info, ucontext);
+                return;
+        }
+        if (old->sa_handler && old->sa_handler != SIG_DFL &&
+            old->sa_handler != SIG_IGN) {
+                old->sa_handler(sig);
+                return;
+        }
+        signal(sig, SIG_DFL);
