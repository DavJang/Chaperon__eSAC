+bool syscall_context::should_kernelize(const char *name)
+{
+	if (!kernel_map_names.empty()) {
+		std::string n = name ? std::string(name) : std::string();
+		size_t start = 0;
+		while (true) {
+			size_t comma = kernel_map_names.find(',', start);
+			std::string tok = kernel_map_names.substr(start,
+				comma == std::string::npos ? std::string::npos : comma - start);
